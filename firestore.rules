rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure multi-tenant isolation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function belongsToBusiness(businessId) {
      return isAuthenticated() && 
        (resource == null || resource.data.businessId == businessId) &&
        (request.resource == null || request.resource.data.businessId == businessId);
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Businesses Collection
    match /businesses/{businessId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.ownerId == request.auth.uid) &&
        (request.resource == null || request.resource.data.ownerId == request.auth.uid);
    }

    // Products Collection (Scoped to Business ID)
    match /products/{productId} {
      allow read, write: if isAuthenticated() && 
        (request.resource.data.businessId != null && 
         exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)) &&
         get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid);
    }

    // Invoices Collection (Scoped to Business ID)
    match /invoices/{invoiceId} {
      allow read, create, update: if isAuthenticated() &&
        (request.resource.data.businessId != null &&
         exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)) &&
         get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid);
      allow delete: if false; // Invoices are audit logs, deletion restricted
    }

    // Customers Collection (Scoped to Business ID)
    match /customers/{customerId} {
      allow read, write: if isAuthenticated() && 
        (request.resource.data.businessId != null &&
         exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)) &&
         get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid);
    }
  }
}
